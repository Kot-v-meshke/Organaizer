<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Organizer Web Application</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>EventListServlet</servlet-name>
        <servlet-class>vsu.task.controller.EventListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EventListServlet</servlet-name>
        <url-pattern>/events</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EventFormServlet</servlet-name>
        <servlet-class>vsu.task.controller.EventFormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EventFormServlet</servlet-name>
        <url-pattern>/event-form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteEventServlet</servlet-name>
        <servlet-class>vsu.task.controller.DeleteEventServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteEventServlet</servlet-name>
        <url-pattern>/delete-event</url-pattern>
    </servlet-mapping>

</web-app>